# Runtime
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:14b
SMALL_LLM_MODEL=qwen2.5:1.5b
LARGE_LLM_MODEL=qwen3:14b
MODEL_ROUTER_ENABLED=false
LLM_TEMPERATURE=0
RAG_DEFAULT_COLLECTION=default
GRADIO_HOST=127.0.0.1
GRADIO_PORT=7860
API_HOST=127.0.0.1
API_PORT=8000

# PDF parsing
# auto = use fast text extraction for large/image-heavy PDFs, layout = best Markdown structure, fast = fastest
PDF_PARSE_MODE=auto
PDF_FAST_PARSE_FILE_MB=20
PDF_FAST_PARSE_IMAGE_COUNT=30

# Ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434

# OpenAI (optional, requires `pip install langchain-openai`)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Google Gemini (optional, requires `pip install langchain-google-genai`)
# LLM_PROVIDER=google
# LLM_MODEL=gemini-2.5-flash
# GOOGLE_API_KEY=your-google-api-key

# Corrective RAG web-search fallback (optional; default off)
CRAG_ENABLED=false
CRAG_PROVIDER=tavily
# TAVILY_API_KEY=tvly-...
# SERPER_API_KEY=...
CRAG_MAX_RESULTS=5
CRAG_SEARCH_DEPTH=basic
CRAG_TIMEOUT_SECONDS=20

# Retrieval / Evaluation
RETRIEVAL_MODE=baseline_hybrid
RERANKER_ENABLED=true
RERANKER_MODEL=BAAI/bge-reranker-base

# Agent behavior
SKILLS_ENABLED=true
REFLECTION_ENABLED=true
MAX_REFLECTION_ROUNDS=1
MIN_EVIDENCE_SCORE=0.7
MULTI_AGENT_PLANNER_ENABLED=true
# EVAL_OUTPUT_DIR=/absolute/path/to/evaluation/reports
# EVAL_DEFAULT_DATASET=/absolute/path/to/project/evaluation/datasets/sample_eval.jsonl

# LightRAG (optional)
LIGHTRAG_ENABLED=true
LIGHTRAG_BASE_URL=http://127.0.0.1:9621
LIGHTRAG_QUERY_MODE=mix
LIGHTRAG_TIMEOUT_SECONDS=180
LIGHTRAG_TOP_K=10
LIGHTRAG_CHUNK_TOP_K=10

# Langfuse Observability (optional)
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3000

# Phoenix Tracing (optional)
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT_NAME=agentic-rag-platform
PHOENIX_PROTOCOL=http/protobuf
# PHOENIX_API_KEY=

# MCP Filesystem Server (optional, requires `pip install "mcp[cli]"`)
MCP_FILESYSTEM_ENABLED=true
MCP_FILESYSTEM_SERVER_NAME=agentic-rag-filesystem
MCP_FILESYSTEM_TRANSPORT=stdio
# MCP_FILESYSTEM_ALLOWED_ROOTS=/abs/path/to/repo,/abs/path/to/repo/project/evaluation,/abs/path/to/repo/project/test_corpus
# MCP_FILESYSTEM_MAX_READ_CHARS=12000
# MCP_FILESYSTEM_MAX_SEARCH_RESULTS=25
